# Copy to .env and adjust. All values have working offline defaults.

# Embeddings: "sentence-transformers" (real, downloads a model) or "hashing" (offline)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40

# Retrieval
SPARSE_K=20
DENSE_K=20
RRF_K_CONSTANT=60
FINAL_K=5

# Cross-encoder reranker (optional)
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=25

# Semantic cache
CACHE_ENABLED=true
CACHE_SIM_THRESHOLD=0.97

# Generation: "mock" (offline), "anthropic", or "openai"
LLM_PROVIDER=mock
ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
